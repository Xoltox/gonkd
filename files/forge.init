#!/bin/sh /etc/rc.common
# procd init script for forge, a lean print server bridging this box's
# USB-attached Marlin printer to the network.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/forge

start_service() {
	procd_open_instance
	procd_set_param command "$PROG" \
		-listen ":80" \
		-port "/dev/ttyUSB0" \
		-baud 250000 \
		-data-dir "/tmp/forge" \
		-names-file "/etc/forge/names.json"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="1024 1024"
	procd_close_instance
}

stop_service() {
	:
}
